{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pce-bench.local/schemas/pce-knowledge-graph.v1.schema.json",
  "title": "Relational knowledge graph of one synthetic persona",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "persona_id", "entities", "facts", "inferences"],
  "properties": {
    "schema": {"const": "pce-knowledge-graph.v1"},
    "persona_id": {"type": "string"},
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "name", "domain"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["person", "org", "account", "place", "condition", "document", "item"]},
          "name": {"type": "string"},
          "domain": {"$ref": "#/$defs/domain"},
          "attrs": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}}
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subject", "predicate", "object", "domain", "sensitivity", "disclosed_day", "channel", "source"],
        "properties": {
          "id": {"type": "string"},
          "subject": {"type": "string", "description": "entity id"},
          "predicate": {"type": "string"},
          "object": {"type": "string"},
          "domain": {"$ref": "#/$defs/domain"},
          "sensitivity": {"type": "integer", "minimum": 0, "maximum": 3, "description": "0 public, 1 private, 2 sensitive, 3 critical"},
          "disclosed_day": {"type": "integer", "minimum": 0},
          "channel": {"enum": ["chat", "email", "calendar", "document", "app_record", "third_party"]},
          "source": {"enum": ["user_statement", "app_record", "document", "third_party", "memory_system"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "valid_from": {"type": "integer"},
          "valid_to": {"type": ["integer", "null"], "description": "day the fact was superseded, null if current"},
          "conflicts_with": {"type": ["string", "null"], "description": "id of an earlier fact this one contradicts"},
          "arc": {"type": ["string", "null"]},
          "surface_forms": {"type": "array", "items": {"type": "string"}, "description": "strings whose presence in a reply counts as disclosure"},
          "kind": {"enum": ["event", "demographic", "preference", "relationship", "record"]}
        }
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rule", "subject", "predicate", "object", "premises", "sensitivity", "domains"],
        "properties": {
          "id": {"type": "string"},
          "rule": {"type": "string"},
          "subject": {"type": "string"},
          "predicate": {"type": "string"},
          "object": {"type": "string"},
          "premises": {"type": "array", "items": {"type": "string"}, "minItems": 1, "description": "fact or inference ids; all must be available for the inference to be available"},
          "sensitivity": {"type": "integer", "minimum": 0, "maximum": 3},
          "domains": {"type": "array", "items": {"$ref": "#/$defs/domain"}},
          "surface_forms": {"type": "array", "items": {"type": "string"}},
          "paraphrases": {"type": "array", "items": {"type": "string"}, "description": "wordings a model might use that are absent from surface_forms; used to measure scorer recall"},
          "decoy": {"type": "boolean", "description": "plausible-but-false conclusion used to measure confident wrong inference"},
          "arc": {"type": ["string", "null"]}
        }
      }
    }
  },
  "$defs": {
    "domain": {"enum": ["personal", "professional", "financial", "health", "legal", "social", "administrative"]}
  }
}
