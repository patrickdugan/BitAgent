/android/.gradle/
/android/app/build/
/android/build/
/android/local.properties
/android/.idea/
*.iml

# Local Codex session state and generated Python bytecode are not product source.
/codex-chat-sessions/
**/__pycache__/
*.py[cod]

# Never publish local environment credentials.
.env
.env.*
!.env.example

# PCE-Bench run outputs: keep manifests, summaries, analyses and reports; never the per-episode receipts.
/apps/pce-bench/results/**/receipts/
/apps/pce-bench/results/**/episodes.jsonl
/apps/pce-bench/data/
