{
  "schema": "bitagent.skill_mcp12k_resource_manifest.v1",
  "skill": "tradelayer-collateral-lifecycle",
  "context": {
    "mode": "mcp_intensive_12k",
    "hardContextTokens": 12000,
    "fixedOverheadMaxTokens": 2400,
    "toolSchemaMaxTokens": 2000,
    "workingPacketMaxTokens": 4000,
    "toolResultReserveTokens": 1500,
    "outputReserveTokens": 1024,
    "safetyMarginTokens": 1076,
    "externalSummaryMaxTokens": 6000,
    "summarySliceMaxTokens": 800,
    "targetActiveTools": 3,
    "maxActiveTools": 5,
    "maxToolRounds": 3,
    "maxToolCalls": 6,
    "maxResourceHandles": 5,
    "maxFailureReplays": 1,
    "rawResultsInline": false,
    "rawTranscriptsInline": false
  },
  "authority": {
    "candidateOnly": true,
    "roleOwner": "deterministic_host",
    "stateTruth": "deterministic_host_and_independent_observers",
    "approval": false,
    "signing": false,
    "broadcast": false,
    "execution": false,
    "retry": false
  },
  "resources": [
    {
      "id": "lifecycle_contract",
      "path": "references/lifecycle-contract.md",
      "kind": "contract"
    },
    {
      "id": "tool_map",
      "path": "references/tool-map.md",
      "kind": "tool_map"
    },
    {
      "id": "workflow_state",
      "uri": "mcp://bitagent/workflows/{workflowId}",
      "kind": "durable_state"
    },
    {
      "id": "wallet_public_state",
      "uri": "mcp://bitagent/wallet-authority/{walletSessionId}",
      "kind": "public_evidence"
    },
    {
      "id": "raw_evidence",
      "uri": "mcp://bitagent/evidence/{sha256}",
      "kind": "external_hash_bound_artifact"
    }
  ],
  "phasePackets": [
    {
      "phase": "resume",
      "role": "recovery_operator",
      "tools": ["bitagent.workflow.get"],
      "resources": ["workflow_state", "raw_evidence"]
    },
    {
      "phase": "wallet",
      "role": "intent_planner",
      "tools": ["bitagent.wallet.connect", "bitagent.workflow.get"],
      "resources": ["lifecycle_contract", "workflow_state"]
    },
    {
      "phase": "deposit",
      "role": "intent_planner",
      "tools": ["bitagent.deposit.prepare", "bitagent.workflow.get"],
      "resources": ["lifecycle_contract", "workflow_state", "wallet_public_state"]
    },
    {
      "phase": "signal",
      "role": "utxo_tradelayer_specialist",
      "tools": ["bitagent.signal.get", "bitagent.signal.simulate", "bitagent.workflow.get"],
      "resources": ["tool_map", "workflow_state", "raw_evidence"]
    },
    {
      "phase": "strategy_simulation",
      "role": "utxo_tradelayer_specialist",
      "tools": ["bitagent.strategy.simulate", "bitagent.signal.simulate", "bitagent.workflow.get"],
      "resources": ["lifecycle_contract", "workflow_state", "raw_evidence"]
    },
    {
      "phase": "approval",
      "role": "risk_approval_guard",
      "tools": ["bitagent.workflow.get", "bitagent.signal.get"],
      "resources": ["lifecycle_contract", "workflow_state", "wallet_public_state"]
    },
    {
      "phase": "execution",
      "role": "recovery_operator",
      "tools": ["bitagent.workflow.get", "bitagent.action.verify", "bitagent.signal.verify"],
      "resources": ["workflow_state", "wallet_public_state", "raw_evidence"]
    },
    {
      "phase": "pnl_release",
      "role": "recovery_operator",
      "tools": ["bitagent.workflow.get", "bitagent.action.verify"],
      "resources": ["lifecycle_contract", "workflow_state", "raw_evidence"]
    },
    {
      "phase": "withdrawal_simulation",
      "role": "intent_planner",
      "tools": ["bitagent.withdraw.simulate", "bitagent.workflow.get"],
      "resources": ["lifecycle_contract", "workflow_state", "wallet_public_state"]
    },
    {
      "phase": "withdrawal_reconciliation",
      "role": "recovery_operator",
      "tools": ["bitagent.workflow.get", "bitagent.action.verify"],
      "resources": ["workflow_state", "wallet_public_state", "raw_evidence"]
    }
  ]
}
