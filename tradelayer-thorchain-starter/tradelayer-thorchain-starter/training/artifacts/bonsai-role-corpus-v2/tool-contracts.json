    "bitagent.signal.ingest": {
      "name": "bitagent.signal.ingest",
      "lane": "committed_signal",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workflowId",
          "signal"
        ],
        "properties": {
          "workflowId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "signal": {
            "type": "object",
